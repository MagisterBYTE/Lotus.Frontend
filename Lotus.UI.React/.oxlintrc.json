{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Плагины: typescript, import, react, jsx-a11y (как в eslint.config.ts).
  // Storybook-правил в Oxlint нет — stories игнорируются (как в ESLint ignore).
  "plugins": ["typescript", "import", "react", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true,
    "es2020": true
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "coverage/**",
    ".storybook/**",
    "src/.storydata/**",
    "src/external/**",
    "**/*.stories.tsx",
    "eslint.config.ts",
    "jest.config.ts"
  ],
  "options": {
    "typeAware": true
  },
  // Только явные правила из eslint.config.ts (+ базовые из eslint:recommended).
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    //=============================================================
    // REACT - ОСНОВНЫЕ ПРАВИЛА
    //=============================================================
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx", ".jsx"] }],
    // "react/prop-types": нет в Oxlint — в ESLint было off (TypeScript)
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    // "react/no-typos", "react/no-unused-prop-types", "react/no-unused-state" — нет в Oxlint
    "react/no-array-index-key": "warn",
    "react/jsx-handler-names": [
      "warn",
      {
        "eventHandlerPrefix": "handle",
        "eventHandlerPropPrefix": "on"
      }
    ],

    //=============================================================
    // REACT JSX - СТИЛЬ (часть правил нет в Oxlint → Oxfmt)
    //=============================================================
    "react/self-closing-comp": "error",
    // jsx-curly-spacing, jsx-equals-spacing, jsx-indent*, jsx-max-props-per-line,
    // jsx-wrap-multilines, jsx-tag-spacing, jsx-sort-props — нет в Oxlint

    //=============================================================
    // REACT - БЕЗОПАСНОСТЬ И ЛУЧШИЕ ПРАКТИКИ
    //=============================================================
    "react/no-danger": "warn",
    "react/no-direct-mutation-state": "error",
    "react/no-unsafe": "error",
    // "react/prefer-stateless-function", "react/destructuring-assignment" — нет в Oxlint

    //=============================================================
    // REACT - ДОСТУПНОСТЬ (a11y)
    //=============================================================
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",

    //=============================================================
    // БЕЗОПАСНОСТЬ И ПРЕДОТВРАЩЕНИЕ ОШИБОК
    //=============================================================
    "no-constant-condition": "error",
    "no-debugger": "error",
    "no-duplicate-case": "error",
    "no-empty": "error",
    // "no-extra-semi": нет в Oxlint
    "no-fallthrough": "error",
    "no-var": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unreachable": "error",
    "no-cond-assign": "error",
    "no-extra-boolean-cast": "error",
    "prefer-rest-params": "error",

    //=============================================================
    // СТИЛЬ КОДА И ФОРМАТИРОВАНИЕ
    //=============================================================
    // quotes, indent, brace-style(allman), padded-blocks, *-spacing, semi*,
    // spaced-comment, max-len, comma-dangle — нет в Oxlint → форматтер.
    // @typescript-eslint/naming-convention — аналога нет.
    "max-lines": ["warn", { "max": 1200 }],

    //=============================================================
    // СОВРЕМЕННЫЙ JAVASCRIPT/TYPESCRIPT
    //=============================================================
    "prefer-arrow-callback": "error",
    "prefer-template": "error",
    "no-useless-constructor": "warn",
    "prefer-const": "error",
    "no-inner-declarations": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    // В eslint.config.ts было off
    "typescript/no-misused-promises": "off",
    "typescript/ban-ts-comment": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-empty-object-type": "error",

    //=============================================================
    // АСИНХРОННЫЙ КОД
    //=============================================================
    "typescript/return-await": "error",
    "require-await": "error",

    //=============================================================
    // КОНТРОЛЬ СЛОЖНОСТИ КОДА
    //=============================================================
    "complexity": ["warn", 20],
    "max-params": ["warn", 4],
    "max-depth": ["warn", 4],
    "max-nested-callbacks": ["warn", 3],

    //=============================================================
    // ОРГАНИЗАЦИЯ ИМПОРТОВ
    //=============================================================
    // import/order, import/no-useless-path-segments — нет в Oxlint
    "import/no-duplicates": "error"
  }
}
