{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Перенесено из .prettierrc
  "semi": true,
  "singleQuote": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "printWidth": 160,
  "tabWidth": 2,
  "trailingComma": "none",
  // Oxfmt читает .editorconfig сам; опция editorconfig из Prettier не поддерживается.
  // Не сортировать package.json (в Prettier он был в ignore)
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/.git",
    "**/node_modules",
    "**/package.json",
    "**/package-lock.json",
    "dist/**",
    "coverage/**",
    "storybook-static/**"
  ]
}
