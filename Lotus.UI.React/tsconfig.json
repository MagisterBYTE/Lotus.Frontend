{
  "extends": "../Lotus.Config/tsconfig.library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDirs": ["src"],
    "outDir": "./dist/esm",
    "rootDir": "./src",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/*.stories.tsx", // Игнорирует все файлы с расширением .stories.tsx
    "**/*.stories.ts", // Игнорирует все файлы с расширением .stories.ts
    "**/*.stories.js", // Игнорирует все файлы с расширением .stories.js
    "**/*.stories.jsx" // Игнорирует все файлы с расширением .stories.jsx
  ]
}
